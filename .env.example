# DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/db_name?schema=public"

# Conexion de SOLO LECTURA para las consultas del asistente de IA (#2b).
# Rol analista_ia, creado con prisma/migrations/manual/002_rol_analista_solo_lectura.sql
# Sin esta variable el asistente usa la conexion principal: funciona, pero
# pierde la unica defensa que no depende del validador de texto.
DATABASE_URL_ANALISTA=

# REDIS (Upstash or local)
REDIS_URL="redis://localhost:6379"
REDIS_TOKEN="your_redis_token_if_upstash"

# AUTHENTICATION
# Obligatorio, minimo 32 caracteres. Generalo con: openssl rand -base64 32
# La aplicacion no arranca sin el.
NEXTAUTH_SECRET=
# En produccion DEBE empezar por https://: de ello depende que la cookie de
# sesion se marque como segura y no viaje nunca en claro.
NEXTAUTH_URL="http://localhost:3000"

# AI (GEMINI)
GEMINI_API_KEY="your_google_ai_key"

# Poner en "true" SOLO si delante hay un proxy que reescribe x-forwarded-for
# (por ejemplo el de Hostinger). En local debe quedar sin definir: creerse esa
# cabecera sin proxy delante permite saltarse el limite de peticiones y dejar
# fuera del panel a otro usuario poniendo su IP.
TRUST_PROXY_HEADERS=

# Interfaz en la que escucha el servidor. Con TRUST_PROXY_HEADERS=true escucha
# solo en 127.0.0.1, para que nadie pueda saltarse el proxy y llegar directo.
# En un despliegue con contenedores, donde el proxy vive en otro contenedor,
# hay que poner HOST=0.0.0.0 o el servicio queda inalcanzable.
HOST=

# Clave de SERVICIO de Supabase (Dashboard > API Keys > secret).
# Solo servidor: se salta Row Level Security por completo, asi que NUNCA debe
# ir en una variable NEXT_PUBLIC_* ni llegar al navegador. La usa la subida de
# imagenes y videos del constructor de mensajes.
SUPABASE_SECRET_KEY=

# Cifra las claves de API que se guardan en la tabla de configuracion.
# Generala con: openssl rand -base64 32
# Si se pierde, las claves guardadas hay que volver a introducirlas.
CONFIG_ENCRYPTION_KEY=

# WEBHOOKS ENTRANTES
# (sin uso ahora mismo: no hay proveedor de mensajeria conectado. Cuando se
#  conecte uno, su webhook debe autenticarse con un secreto compartido; la
#  comprobacion esta en lib/webhooks/verificar.ts)
# Secretos compartidos que autentican a los proveedores externos. Minimo 16
# caracteres; generalos con: openssl rand -base64 24
# El de Evolution debe configurarse ademas en el propio Evolution API, como
# cabecera del webhook:  x-webhook-secret: <valor>
# Sin estas variables los webhooks rechazan todo: un webhook sin secreto es
# un webhook abierto.
INTERNAL_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_SECRET=

# WHATSAPP
WHATSAPP_WEBHOOK_SECRET="your_webhook_secret"
WHATSAPP_ENCRYPTION_KEY="your_encryption_key_32_chars"

# MONITORING (SENTRY)
NEXT_PUBLIC_SENTRY_DSN="your_sentry_dsn"
SENTRY_DSN="your_sentry_dsn"
SENTRY_AUTH_TOKEN="your_sentry_token"

# APP SETTINGS
NODE_ENV="development"

# WHATSAPP
# Secreto que protege la ruta del latido (/api/whatsapp/latido), la que llama
# el cron del hPanel para que el alojamiento no duerma la aplicacion y las
# lineas no se queden mudas. Sin el, cualquiera podria forzar reconexiones a
# voluntad, que es una buena manera de que WhatsApp bloquee el numero.
# Generalo con: openssl rand -base64 32
WHATSAPP_SECRETO_LATIDO=
